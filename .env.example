SITE_URL=http://localhost:3000
# Leave empty to use the local JSON adapter.
MONGODB_URI=
MONGODB_DB=launchdeck
# Optional in development. Required for admin access in production.
ADMIN_PASSWORD=
# Set to a strong random value when deploying publicly.
SESSION_SECRET=

# Public Vercel Blob store token (server-only; never prefix with NEXT_PUBLIC_).
BLOB_READ_WRITE_TOKEN=
# Optional public Vercel Blob origin for bundled editorial images.
BLOG_BLOB_BASE_URL=

# Resend API key and a verified sender address for password resets.
RESET_EMAIL_API_KEY=
RESET_EMAIL_FROM=

# Optional Gmail sender. When both values are supplied, Gmail takes precedence over Resend.
RESET_GMAIL_USER=
RESET_GMAIL_APP_PASSWORD=
